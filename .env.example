# Database credentials
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
spring.datasource.url=jdbc:postgresql://your_db_host:5432/your_db_name?sslmode=require

# Redis credentials
REDIS_HOST=your_redis_host
REDIS_PORT=6379
spring.data.redis.password=your_redis_password

# RabbitMQ credentials
spring.rabbitmq.host=your_rabbitmq_host
spring.rabbitmq.port=5672
spring.rabbitmq.username=your_rabbitmq_username
spring.rabbitmq.password=your_rabbitmq_password
spring.rabbitmq.virtual-host=your_rabbitmq_virtual_host

# Mail credentials
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password

# Application encryption
APP_ENCRYPTION_KEY=your_app_encryption_key_32_characters

# OAuth2 Client ID and Secrets
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Resend API Key
RESEND=your_resend_api_key

# Admin User Seed credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# S3 Storage (only required when running with the 'prod' Spring profile)
APP_STORAGE_S3_BUCKET_NAME=your_s3_bucket_name
APP_STORAGE_S3_REGION=us-east-1
# AWS credentials should be supplied via IAM role / instance profile in production.
# For local prod-profile testing only:
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
